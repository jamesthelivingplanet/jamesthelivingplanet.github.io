---
import { getLangFromUrl, useTranslations, languages, defaultLang, localizePath } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Strip any leading locale segment from current path so we can swap to the other locale cleanly.
const rawPath = Astro.url.pathname;
const stripped = rawPath.replace(/^\/(en|es)(?=\/|$)/, '') || '/';
const langCodes = Object.keys(languages) as Array<keyof typeof languages>;
---

<header class="site-header reveal r-1">
  <h1 class="site-name">Alberto Le Baron</h1>
  <div class="name-rule" aria-hidden="true"></div>
  <nav class="site-nav" aria-label="Primary navigation">
    <a href={localizePath('/', lang)}>{t('nav.writing')}</a>
    <a href={localizePath('/now', lang)}>{t('nav.now')}</a>
    <a href={localizePath('/projects', lang)}>{t('nav.projects')}</a>
    <a href={localizePath('/links', lang)}>{t('nav.links')}</a>
    <span class="lang-switch" aria-label="Language">
      {langCodes.map((code, i) => (
        <>
          {i > 0 && <span class="lang-divider">/</span>}
          <a
            href={code === defaultLang ? (stripped || '/') : `/${code}${stripped === '/' ? '' : stripped}`}
            class:list={['lang-link', { active: code === lang }]}
            hreflang={code}
            aria-current={code === lang ? 'true' : undefined}
          >{languages[code]}</a>
        </>
      ))}
      <span class="lang-divider">/</span>
      <button type="button" class="lang-link lang-toggle" data-matoran-toggle aria-pressed="false">MA</button>
    </span>
  </nav>
</header>
